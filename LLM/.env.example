# LLM Service — Shared LLM Gateway
# ══════════════════════════════════════════════════════════════
# Provides a unified /generate endpoint that abstracts:
#   • Ollama (local LLM on port 11434)
#   • Gemini API (cloud fallback)
#
# Both Engine1 (docs) and Engine2 (lgu) call this service
# instead of each maintaining their own LLM integration.
# ══════════════════════════════════════════════════════════════

# Ollama (running on the same machine)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Gemini API (cloud fallback)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Server
HOST=0.0.0.0
PORT=8003

# Timeouts (seconds)
OLLAMA_TIMEOUT=60
GEMINI_TIMEOUT=30
